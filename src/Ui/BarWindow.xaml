<Window x:Class="Flick.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Flick"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" ResizeMode="NoResize" Title="Flick" Left="-32000" Top="-32000"
        Width="768" Height="500" FontFamily="{StaticResource UiFont}" Foreground="White" UseLayoutRounding="True"
        ToolTipService.InitialShowDelay="500">
    <Grid x:Name="Root" TextElement.Foreground="White">

        <!-- Result toast: what just happened and how to use it. -->
        <Grid x:Name="Toast" Width="430" HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0" Visibility="Collapsed"
              MouseEnter="OnToastEnter" MouseLeave="OnToastLeave">
            <Grid.RenderTransform><TranslateTransform x:Name="ToastSlide"/></Grid.RenderTransform>
            <Border CornerRadius="16" Background="{StaticResource PanelFill}" BorderBrush="{StaticResource PanelRim}" BorderThickness="1" Padding="9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ToastThumbFrame" Width="64" Height="44" CornerRadius="8" ClipToBounds="True" Background="{StaticResource Fill1}" Margin="0,0,11,0">
                        <Grid>
                            <Image x:Name="ToastThumb" Stretch="UniformToFill">
                                <Image.Clip><RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,64,44"/></Image.Clip>
                            </Image>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="ToastIcon" Style="{StaticResource IconStroke}" Stroke="#FFC8C8CC" StrokeThickness="2.4" Margin="-4,-3,1,-3" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><ScaleTransform ScaleX="0.7" ScaleY="0.7"/></Path.RenderTransform>
                            </Path>
                            <TextBlock x:Name="ToastTitle" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="ToastBody" FontSize="12" Foreground="{StaticResource InkSoft}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button x:Name="ToastOpen" Grid.Column="2" Style="{StaticResource RoundButton}" Width="36" Height="36" Margin="8,0,0,0" Click="OnOpenFolder" ToolTip="Show the file in its folder">
                        <Path Style="{StaticResource IconStroke}" Data="{StaticResource IconFolder}" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8"/></Path.RenderTransform>
                        </Path>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- First-run guide: what this app is for, in one look. -->
        <Grid x:Name="Guide" Width="720" HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0" Visibility="Collapsed">
            <Grid.RenderTransform><TranslateTransform x:Name="GuideSlide"/></Grid.RenderTransform>
            <Border CornerRadius="20" Background="{StaticResource PanelFill}" BorderBrush="{StaticResource PanelRim}" BorderThickness="1" Padding="20,16,20,16">
                <StackPanel>
                    <TextBlock Text="Quick clips and screenshots, ready to paste." FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Flick is for fast captures you want to send right now, not long videos to edit." FontSize="13" Foreground="{StaticResource InkSoft}" Margin="0,3,0,14"/>
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="1" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkFaint}"/>
                            <TextBlock Text="Choose what to capture" FontSize="13.5" FontWeight="SemiBold" Margin="0,2,0,2"/>
                            <TextBlock Text="Screenshot or Record, then the whole screen, one window or an area." FontSize="12" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="2" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkFaint}"/>
                            <TextBlock Text="Capture" FontSize="13.5" FontWeight="SemiBold" Margin="0,2,0,2"/>
                            <TextBlock Text="While recording, this bar disappears. A small stop button stays that only you can see. It's never in the video." FontSize="12" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="3" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkFaint}"/>
                            <TextBlock Text="Paste it anywhere" FontSize="13.5" FontWeight="SemiBold" Margin="0,2,0,2"/>
                            <TextBlock Text="It's already copied. Press Ctrl+V in any chat, email or folder. A copy is saved too." FontSize="12" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </UniformGrid>
                    <Grid Margin="0,14,0,0">
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource InkSoft}">
                            <Run Text="Ctrl+Shift+5" FontWeight="SemiBold" Foreground="White"/><Run Text="  shows this bar, or stops a recording, from any app."/>
                        </TextBlock>
                        <Button Style="{StaticResource PrimaryButton}" Width="92" Height="34" HorizontalAlignment="Right" Click="OnGuideDone">
                            <TextBlock Text="Got it" FontSize="13" FontWeight="SemiBold"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Quality strip: real examples from the screen, with sizes. -->
        <Grid x:Name="Strip" Width="720" HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0" Visibility="Collapsed">
            <Grid.RenderTransform><TranslateTransform x:Name="StripSlide"/></Grid.RenderTransform>
            <Border CornerRadius="20" Background="{StaticResource PanelFill}" BorderBrush="{StaticResource PanelRim}" BorderThickness="1" Padding="10,11,10,10">
                <StackPanel>
                    <Grid Margin="11,0,11,9">
                        <TextBlock x:Name="StripTitle" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StripNote" FontSize="11.5" Foreground="{StaticResource InkFaint}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <ItemsControl x:Name="Cards">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:CardModel}">
                                <ToggleButton Style="{StaticResource QualityCard}" IsChecked="{Binding Chosen, Mode=OneWay}" Click="OnCard" Tag="{Binding}" Margin="5,0">
                                    <StackPanel Margin="6,6,6,8">
                                        <Border CornerRadius="9" Height="84" Background="#22FFFFFF" ClipToBounds="True">
                                            <Image Source="{Binding Image}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Linear">
                                                <Image.Clip><RectangleGeometry RadiusX="9" RadiusY="9" Rect="0,0,153,84"/></Image.Clip>
                                            </Image>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Margin="4,6,0,0" Foreground="White"/>
                                        <TextBlock Text="{Binding Big}" FontSize="12" Margin="4,1,0,0" Foreground="White" Typography.NumeralAlignment="Tabular"/>
                                        <TextBlock Text="{Binding Small}" FontSize="11" Margin="4,1,0,0" Foreground="{StaticResource InkSoft}" Typography.NumeralAlignment="Tabular"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Margin="4,1,0,0" Foreground="{StaticResource InkFaint}" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- The bar. -->
        <Grid x:Name="Bar" Width="720" Height="70" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24">
            <Grid.RenderTransform><TranslateTransform x:Name="BarSlide"/></Grid.RenderTransform>
            <Border x:Name="BarBody" CornerRadius="20" Background="{StaticResource PanelFill}" BorderBrush="{StaticResource PanelRim}" BorderThickness="1"
                    MouseLeftButtonDown="OnDragStart" MouseMove="OnDragMove" MouseLeftButtonUp="OnDragEnd" Padding="10,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource RoundButton}" Width="28" Height="28" Click="OnClose" ToolTip="Hide Flick. Ctrl+Shift+5 brings it back.">
                        <Path Style="{StaticResource IconStroke}" Data="{StaticResource IconClose}" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform><ScaleTransform ScaleX="0.72" ScaleY="0.72"/></Path.RenderTransform>
                        </Path>
                    </Button>

                    <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource Divider}" Margin="8,10"/>

                    <!-- Screenshot or record. The highlight glides between them. -->
                    <Grid Grid.Column="2" Width="148">
                        <Border x:Name="ModeMark" Width="68" Margin="3" HorizontalAlignment="Left" CornerRadius="10" Background="{StaticResource Fill2}">
                            <Border.RenderTransform><TranslateTransform x:Name="ModeSlide"/></Border.RenderTransform>
                        </Border>
                        <UniformGrid Rows="1">
                            <local:ToolButton x:Name="ModeShot" Word="Screenshot" Icon="{StaticResource IconCamera}" Click="OnModeShot" ToolTip="Take a picture"/>
                            <local:ToolButton x:Name="ModeRecord" Word="Record" Icon="{StaticResource IconRing}" DotIcon="{StaticResource IconDot}" Click="OnModeRecord" ToolTip="Record a video"/>
                        </UniformGrid>
                    </Grid>

                    <Rectangle Grid.Column="3" Width="1" Fill="{StaticResource Divider}" Margin="8,10"/>

                    <!-- What to capture. -->
                    <Grid Grid.Column="4" Width="186">
                        <Border x:Name="TargetMark" Width="56" Margin="3" HorizontalAlignment="Left" CornerRadius="10" Background="{StaticResource Fill2}">
                            <Border.RenderTransform><TranslateTransform x:Name="TargetSlide"/></Border.RenderTransform>
                        </Border>
                        <UniformGrid Rows="1">
                            <local:ToolButton x:Name="TargetScreen" Word="Screen" Icon="{StaticResource IconScreen}" Click="OnTargetScreen" ToolTip="The whole screen"/>
                            <local:ToolButton x:Name="TargetWindow" Word="Window" Icon="{StaticResource IconWindow}" Click="OnTargetWindow" ToolTip="Pick one window"/>
                            <local:ToolButton x:Name="TargetArea" Word="Area" Icon="{StaticResource IconArea}" Click="OnTargetArea" ToolTip="Drag out an area"/>
                        </UniformGrid>
                    </Grid>

                    <Rectangle Grid.Column="5" Width="1" Fill="{StaticResource Divider}" Margin="8,10"/>

                    <StackPanel Grid.Column="6" Orientation="Horizontal">
                        <local:ToolButton x:Name="QualityButton" Width="66" Word="Good" Icon="{StaticResource IconQuality}" Click="OnQualityToggle" ToolTip="Quality and file size"/>
                        <local:ToolButton x:Name="SoundButton" Width="66" Word="Sound on" Icon="{StaticResource IconSoundOn}" Click="OnSoundToggle" ToolTip="Record what your computer is playing"/>
                    </StackPanel>

                    <Button x:Name="GoButton" Grid.Column="7" Style="{StaticResource PrimaryButton}" Margin="10,4,2,4" Click="OnGo">
                        <StackPanel Orientation="Horizontal">
                            <Grid x:Name="GoDot" Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse Fill="#FF3C3C3F"/>
                            </Grid>
                            <TextBlock x:Name="GoText" Text="Record" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,1"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
