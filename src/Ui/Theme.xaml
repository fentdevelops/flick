<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Flick">

    <!-- Motion, carried over from Glass Player: everything glides, presses answer quickly. -->
    <local:GlideEase x:Key="Glide"/>
    <Duration x:Key="HoverTime">0:0:0.55</Duration>
    <Duration x:Key="PressTime">0:0:0.14</Duration>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Plain grey, on purpose: the user asked for no gradients, rims, shadows or colour. -->
    <SolidColorBrush x:Key="PanelFill" Color="#FF3C3C3F"/>
    <SolidColorBrush x:Key="PanelRim" Color="#FF4C4C50"/>
    <SolidColorBrush x:Key="Ink" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="InkSoft" Color="#C7FFFFFF"/>
    <SolidColorBrush x:Key="InkFaint" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="Fill1" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="Fill2" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="Divider" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Red" Color="#FFC8C8CC"/>

    <!-- Icons: 24 px grid, one weight, rounded ends. -->
    <Geometry x:Key="IconCamera">M4 8.5A1.5 1.5 0 0 1 5.5 7H8l1.5-2.5h5L16 7h2.5A1.5 1.5 0 0 1 20 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.5z M12 9.8a3.3 3.3 0 1 0 0 6.6 3.3 3.3 0 0 0 0-6.6z</Geometry>
    <Geometry x:Key="IconRing">M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z</Geometry>
    <Geometry x:Key="IconDot">M12 7.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9z</Geometry>
    <Geometry x:Key="IconScreen">M4 5h16a1 1 0 0 1 1 1v10.5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z M8.5 21h7 M12 17.5V21</Geometry>
    <Geometry x:Key="IconWindow">M4.5 4.5h15A1.5 1.5 0 0 1 21 6v12a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 18V6a1.5 1.5 0 0 1 1.5-1.5z M3 9.2h18 M6.3 6.9h.01 M9.1 6.9h.01</Geometry>
    <Geometry x:Key="IconArea">M4 8.5V5a1 1 0 0 1 1-1h3.5 M15.5 4H19a1 1 0 0 1 1 1v3.5 M20 15.5V19a1 1 0 0 1-1 1h-3.5 M8.5 20H5a1 1 0 0 1-1-1v-3.5</Geometry>
    <Geometry x:Key="IconSoundOn">M4 9.5v5h3.5l4.5 4v-13l-4.5 4z M15.5 9a4.2 4.2 0 0 1 0 6 M18 6.5a7.8 7.8 0 0 1 0 11</Geometry>
    <Geometry x:Key="IconSoundOff">M4 9.5v5h3.5l4.5 4v-13l-4.5 4z M16 9.5l5 5 M21 9.5l-5 5</Geometry>
    <Geometry x:Key="IconQuality">M4 7h9 M17.5 7H20 M4 17h2.5 M11 17h9 M15.2 4.9a2.1 2.1 0 1 0 0 4.2 2.1 2.1 0 0 0 0-4.2z M8.8 14.9a2.1 2.1 0 1 0 0 4.2 2.1 2.1 0 0 0 0-4.2z</Geometry>
    <Geometry x:Key="IconClose">M7 7l10 10 M17 7L7 17</Geometry>
    <Geometry x:Key="IconCheck">M5 12.5l4.5 4.5L19 7.5</Geometry>
    <Geometry x:Key="IconFolder">M3.5 7A1.5 1.5 0 0 1 5 5.5h4l2 2.5h8a1.5 1.5 0 0 1 1.5 1.5v8A1.5 1.5 0 0 1 19 19H5a1.5 1.5 0 0 1-1.5-1.5z</Geometry>
    <Geometry x:Key="IconMove">M12 3v18 M3 12h18 M12 3L9.4 5.6 M12 3l2.6 2.6 M12 21l-2.6-2.6 M12 21l2.6-2.6 M3 12l2.6-2.6 M3 12l2.6 2.6 M21 12l-2.6-2.6 M21 12l-2.6 2.6</Geometry>
    <Geometry x:Key="IconResize">M14 4h6v6 M20 4L4 20 M4 14v6h6</Geometry>
    <Geometry x:Key="IconWarn">M12 4l9 15.5H3z M12 10v4.5 M12 17h.01</Geometry>

    <Style x:Key="IconStroke" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        <Setter Property="StrokeThickness" Value="1.7"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>
    </Style>

    <!-- Tool button: icon over a short word. Hover glides in and back out. -->
    <Style TargetType="local:ToolButton">
        <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ToolButton">
                    <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="Press" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                        <Border x:Name="Hover" CornerRadius="10" Margin="3" Background="{StaticResource Fill1}" Opacity="0"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="24" Height="24" HorizontalAlignment="Center">
                                <Path x:Name="Icon" Style="{StaticResource IconStroke}" Data="{TemplateBinding Icon}"/>
                                <Path x:Name="Dot" Width="24" Height="24" Stretch="None" Fill="{StaticResource Red}" Data="{TemplateBinding DotIcon}"/>
                            </Grid>
                            <TextBlock x:Name="Word" Text="{TemplateBinding Word}" Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{StaticResource UiFont}" FontSize="10.5" Margin="0,1,0,0"
                                       HorizontalAlignment="Center" TextOptions.TextFormattingMode="Display"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.94" Duration="{StaticResource PressTime}" EasingFunction="{StaticResource Glide}"/>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.94" Duration="{StaticResource PressTime}" EasingFunction="{StaticResource Glide}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Icon" Property="Opacity" Value="0.35"/>
                            <Setter TargetName="Word" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small round icon button: close, stop, open folder. -->
    <Style x:Key="RoundButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="Press" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                        <Border x:Name="Hover" CornerRadius="99" Background="{StaticResource Fill2}" Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.9" Duration="{StaticResource PressTime}" EasingFunction="{StaticResource Glide}"/>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.9" Duration="{StaticResource PressTime}" EasingFunction="{StaticResource Glide}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The main action: white, the one bright thing on the bar. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FF17171B"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="Press" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                        <Border CornerRadius="13" Background="#FFD2D2D6"/>
                        <Border x:Name="Hover" CornerRadius="13" Background="#FFE0E0E3" Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="{StaticResource PressTime}" EasingFunction="{StaticResource Glide}"/>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="{StaticResource PressTime}" EasingFunction="{StaticResource Glide}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                    <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A quality example card. The ring glides in on the chosen one. -->
    <Style x:Key="QualityCard" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="Grow" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                        <Border x:Name="Hover" CornerRadius="14" Background="{StaticResource Fill1}" Opacity="0"/>
                        <Border x:Name="Chosen" CornerRadius="14" Background="{StaticResource Fill2}" BorderBrush="#FFA8A8AC" BorderThickness="1.5" Opacity="0"/>
                        <ContentPresenter/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                    <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                    <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                    <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                    <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Chosen" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Chosen" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource HoverTime}" EasingFunction="{StaticResource Glide}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#FF3C3C3F"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#FF4C4C50"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
